# Stage 1: Use a full Python base image (needed for TensorFlow dependencies)
FROM python:3.11

# Install unzip and clean up
RUN apt-get update && apt-get install -y unzip && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements first for caching
COPY requirements.txt .
# Install Python dependencies, including TensorFlow
RUN pip install --no-cache-dir -r requirements.txt

# Copy only necessary code and zipped models
COPY prediction.py .
COPY *.zip .
COPY earthquake_data.csv .

# Unzip models and remove zip files
# Adjust paths if zip files contain parent directories
RUN unzip '*.zip' && rm *.zip

# Create the output directory as requested
RUN mkdir -p /app/model_outputs

# Expose the Flask port
EXPOSE 5001

# Run the Flask app
CMD ["python", "prediction.py"]

